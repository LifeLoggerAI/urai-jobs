rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /marketplacePublicJobs/{jobId} {
      allow read: if resource.data.status == 'published'
        && resource.data.moderationStatus == 'approved';
      allow write: if false;
    }

    // Private reads and lifecycle writes use the authenticated marketplace API.
    // Direct clients cannot bypass current account/tenant/consent, duplicate,
    // published-job, employer ownership or withdrawal transaction checks.
    match /marketplaceCandidateProfiles/{uid} { allow read, write: if false; }
    match /marketplaceJobApplications/{applicationId} { allow read, write: if false; }
    match /marketplaceEmployers/{employerId} { allow read, write: if false; }
    match /marketplaceEmployerMembers/{membershipId} { allow read, write: if false; }
    match /marketplaceAdminReviews/{reviewId} { allow read, write: if false; }
    match /marketplaceAuditLogs/{auditId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
