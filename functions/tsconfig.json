{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@urai-jobs/shared-types": ["../packages/shared-types/dist/index.d.ts", "./lib/urai-jobs-shared-types.d.ts"]
    },
    "outDir": "lib/functions",
    "rootDir": "src",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"]
}
