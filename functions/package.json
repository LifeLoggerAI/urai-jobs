{
  "name": "urai-jobs-functions",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node ../scripts/execution-guards-smoke.mjs",
    "seed": "npm run build && npm run seed:compiled",
    "seed:compiled": "node lib/functions/src/seed.js"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^4.8.0",
    "@google-cloud/storage": "^7.10.0",
    "axios": "^1.16.0",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "main": "lib/functions/index.js",
  "overrides": {
    "protobufjs": "7.6.5",
    "protobufjs-cli": "1.3.3",
    "@grpc/grpc-js": "1.14.4",
    "uuid": "11.1.1"
  }
}
