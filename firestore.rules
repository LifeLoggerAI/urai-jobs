rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function activeProfile(profile) {
      return profile.get('uid', request.auth.uid) == request.auth.uid
        && profile.role in ['admin', 'operator', 'user']
        && profile.get('disabled', false) == false
        && profile.get('deleted', false) == false
        && profile.get('suspended', false) == false
        && profile.get('status', 'active') == 'active';
    }

    function currentProtectedAccount() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && activeProfile(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    function operatorToken() {
      return request.auth.token.get('role', '') in ['admin', 'operator']
        || request.auth.token.get('uraiJobsAdmin', false) == true
        || request.auth.token.get('roles', []).hasAny(['admin', 'operator']);
    }

    function isAdmin() {
      return currentProtectedAccount() && getUserRole() == 'admin' && operatorToken();
    }

    function isOwner(resource) {
      return currentProtectedAccount() && request.auth.uid == resource.data.ownerUid;
    }

    function userProfileFieldsUnchanged() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.permissions == resource.data.permissions
        && request.resource.data.disabled == resource.data.disabled
        && request.resource.data.get('deleted', false) == resource.data.get('deleted', false)
        && request.resource.data.get('suspended', false) == resource.data.get('suspended', false)
        && request.resource.data.get('status', null) == resource.data.get('status', null)
        && request.resource.data.get('uid', null) == resource.data.get('uid', null);
    }

    match /users/{uid} {
      allow read: if currentProtectedAccount() && (request.auth.uid == uid || isAdmin());
      allow create: if false;
      allow update: if currentProtectedAccount()
        && request.auth.uid == uid
        && userProfileFieldsUnchanged();
      allow delete: if false;
    }

    match /jobs/{jobId} {
      allow read: if isOwner(resource) || isAdmin();
      allow write: if false;

      match /logs/{logId} {
        allow read: if isOwner(get(/databases/$(database)/documents/jobs/$(jobId))) || isAdmin();
        allow write: if false;
      }
    }

    match /jobQueue/{jobId} {
      allow read, write: if false;
    }

    // Server-only reliability controls. These records contain ownership hashes,
    // delivery state, retry metadata, and provider message identifiers.
    match /jobIdempotencyBindings/{bindingId} {
      allow read, write: if false;
    }

    match /jobTerminalEventOutbox/{eventId} {
      allow read, write: if false;
    }

    // Server-only privacy control records. Client access is intentionally denied.
    match /jobConsentBlocks/{blockId} {
      allow read, write: if false;
    }

    match /jobConsentEventReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Server-only data-rights workflow. Access is mediated by authenticated callables.
    match /dataRightsRequests/{requestId} {
      allow read, write: if false;

      match /audit/{auditId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
