# URAI Jobs Runtime production environment template
# Copy this to ops/production.env locally, or configure the same values in GitHub Actions, Firebase, Cloud Run, or Secret Manager.
# Do not commit real production secrets.

URAI_ENV=prod
NODE_ENV=production

# Public runtime origins allowed to call hosted APIs.
API_ALLOWED_ORIGINS=https://uraijobs.com,https://www.uraijobs.com,https://urai-jobs-563121397472.web.app,https://urai-jobs.web.app

# Firebase / GCP
FIREBASE_PROJECT_ID=urai-jobs
GCLOUD_PROJECT=urai-jobs
GOOGLE_CLOUD_PROJECT=urai-jobs
GCP_REGION=us-central1
FIREBASE_HOSTING_SITE=urai-jobs-563121397472

# Required production secret. Must be at least 24 characters and must not be a placeholder.
WEBHOOK_SIGNING_SECRET=

# Functions -> active worker HTTPS URLs. These must be real https:// URLs.
# Spatial and Career runtime job types remain hard-off in the canonical registry and are intentionally not production requirements here.
NARRATOR_WORKER_URL=
ASSET_WORKER_URL=
STUDIO_WORKER_URL=
COMMUNICATIONS_WORKER_URL=
PRIVATE_SOURCE_WORKER_URL=

# Worker runtime artifact bucket.
GCS_BUCKET_NAME=

# Optional production integrations.
MAILGUN_KEY=
MAILGUN_DOMAIN=
WORKER_SERVICE_ACCOUNT_EMAIL=

# Optional production smoke user/token inputs.
# Prefer an admin/operator account with least privilege required for runtime smoke.
PROD_SMOKE_ID_TOKEN=
PROD_SMOKE_JOB_TYPE=narrator.tts
PROD_SMOKE_TEXT=URAI Jobs Runtime production smoke test


# Captured Reality remains hard-off until source authority, reconstruction engine,
# consent proof, exact-head CI, browser/mobile proof, and explicit launch authority exist.
CAPTURED_REALITY_WORKER_URL=
PRIVATE_SOURCE_AUTHORITY_URL=
PRIVATE_SOURCE_AUTHORITY_TOKEN=
CAPTURED_REALITY_ENGINE_URL=
CAPTURED_REALITY_ENGINE_TOKEN=
CAPTURED_REALITY_WORKER_PUBLIC_URL=

# Separate protected resolver/engine services; never enabled by default.
CAPTURED_REALITY_RESOLVER_URL=
CAPTURED_REALITY_RESOLVER_TOKEN=
CAPTURED_REALITY_PRIVATE_MANIFEST=
CAPTURED_REALITY_PRIVATE_SOURCE_ROOT=
CAPTURED_REALITY_ENGINE_PRIVATE_ROOT=
CAPTURED_REALITY_CALLBACK_ORIGIN=
CAPTURED_REALITY_SPATIAL_AUTHORITY_HEAD=
CAPTURED_REALITY_COMPONENT_ENVELOPE_SHA256=
CAPTURED_REALITY_COMPUTE_ENABLED=false
CAPTURED_REALITY_COMPUTE_AUTHORITY_REF=
CAPTURED_REALITY_MAX_ITERATIONS=30000

# Private-source memory indexing provider (opaque refs only)
PRIVATE_SOURCE_INDEX_URL=
PRIVATE_SOURCE_INDEX_TOKEN=

# Protected private-source v2 preparation. No source ownership or paid execution
# is inferred from configured endpoints; genuine grants/ADC and explicit authority
# are required. The implementation stays disabled by default.
URAI_PRIVATE_SOURCE_CONTRACT=urai-private-source-receipt-v2
URAI_PRIVATE_SOURCE_EXECUTION_ENABLED=false
URAI_PRIVATE_SOURCE_EXECUTION_AUTHORITY_REF=
URAI_PRIVATE_PROVIDER_SPENDING_AUTHORITY_REF=
PRIVATE_SOURCE_TRANSCRIBE_URL=
PRIVATE_SOURCE_TRANSCRIBE_TOKEN=
PRIVATE_SOURCE_REF_RESOLVER_URL=
PRIVATE_SOURCE_REF_RESOLVER_TOKEN=
PRIVATE_SOURCE_ALLOWED_BUCKET=
URAI_PRIVATE_SOURCE_TRANSCRIPTION_ENABLED=false
URAI_PRIVATE_SOURCE_TRANSCRIPTION_AUTHORITY_REF=
URAI_PRIVATE_SOURCE_DIARIZATION_MODEL=
URAI_PRIVATE_LIFE_MODEL_EXECUTION_ENABLED=false
URAI_PRIVATE_LIFE_MODEL_EXECUTION_AUTHORITY_REF=
URAI_LIFE_MODEL_EXTRACTOR_MODEL=
URAI_JOBS_DATA_RIGHTS_ALLOWED_EXPORT_BUCKET=
